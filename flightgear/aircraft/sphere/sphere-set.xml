<?xml version="1.0"?>
<PropertyList>
  <sim>
    <description>sphere</description>
    <flight-model>null</flight-model>
    <model>
      <path>sphere.ac</path>
    </model>

    <!-- Base chase distance -->
    <chase-distance-m>-25.0</chase-distance-m>

    <!-- Configure View 1 (Helicopter / Exterior View) -->
    <view n="1">
      <config>
        <default-field-of-view-deg type="double">55.0</default-field-of-view-deg>
        <x-offset-m type="double">0.0</x-offset-m>
        <y-offset-m type="double">4.0</y-offset-m>
        <z-offset-m type="double">-25.0</z-offset-m>
      </config>
    </view>

    <!-- Automatically switch to View 1 the instant the simulation initializes -->
    <nasal>
      <auto_external_view>
        <script>
          setlistener("/sim/signals/fdm-initialized", func {
              setprop("/sim/current-view/view-number", 1);
          });
        </script>
      </auto_external_view>
    </nasal>
  </sim>
</PropertyList>